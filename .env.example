# Copier en `.env` puis compléter. Les variables obligatoires sont vérifiées au
# démarrage (src/config/validation.ts).

NODE_ENV=development
PORT=5000

# ── Obligatoires ─────────────────────────────────────────────
DATABASE_URL="mysql://root:root@localhost:3307/pointellio"
# 32 caractères minimum : openssl rand -hex 32
JWT_SECRET=""

# ── Redis (obligatoire en production) ───────────────────────
# Sans Redis en local : cache mémoire, jobs inline, logout sans révocation des JWT.
REDIS_URL="redis://localhost:6379"

# ── Sessions JWT ─────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN_MINUTES=15
JWT_REFRESH_EXPIRES_IN_DAYS=30

# ── HTTP ─────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5010"
SWAGGER_ENABLED=true
TRUST_PROXY=false

# ── E-mail transactionnel (SMTP) ─────────────────────────────
# Local : `docker compose up -d mailpit`, puis les messages sur http://localhost:8025
SMTP_ENABLED=true
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
SMTP_USER="pointelio"
SMTP_PASSWORD="pointelio"
SMTP_FROM_EMAIL="noreply@pointelio.local"
SMTP_FROM_NAME="Pointelio"

# ── Invitations (activation de compte) ───────────────────────
INVITATION_ACTIVATION_URL="http://localhost:5010/activation"
INVITATION_TTL_HOURS=72

# ── Options de développement (interdites en production) ──────
INVITATION_RETURN_TOKEN_IN_RESPONSE=false
SOCKET_AUTH_ALLOW_PLAIN_USERID=false

# ── Seed ─────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@pointelio.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
