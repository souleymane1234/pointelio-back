// Pointelio — schéma Prisma (MySQL)
// Multi-tenant : chaque table métier porte entrepriseId, à contrôler sur chaque requête.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ───────────── Enums ─────────────

enum Role {
  SUPER_ADMIN
  SUPPORT
  ADMIN_CLIENT
  RESPONSABLE_RH
  MANAGER
  SURVEILLANT
  EMPLOYE
}

enum StatutCompte {
  INVITE
  ACTIF
  SUSPENDU
  DESACTIVE
}

enum StatutEntreprise {
  ESSAI
  ACTIF
  PAIEMENT_EN_ATTENTE
  EN_RETARD
  SUSPENDU
  RESILIE
}

enum TypePointage {
  ARRIVEE
  DEPART
}

enum MethodePointage {
  QR_GPS
  SURVEILLANT
}

// VALIDE : dans le rayon / A_VERIFIER : zone grise ou précision faible / HORS_ZONE : au-delà du rayon
enum StatutValidation {
  VALIDE
  A_VERIFIER
  HORS_ZONE
}

enum TypeDemande {
  CONGE_ANNUEL
  MALADIE
  AUTORISATION
  RECUPERATION
  AUTRE
}

enum StatutDemande {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
  ANNULEE
}

enum StatutFacture {
  BROUILLON
  EMISE
  PAYEE
  EN_RETARD
  ANNULEE
}

// ───────────── Offres et entreprises ─────────────

model Pack {
  id             Int      @id @default(autoincrement())
  code           String   @unique // STARTER, BUSINESS, BUSINESS_PLUS, ENTREPRISE
  nom            String
  prixMensuel    Int // FCFA, modifiable depuis l'admin
  description    String?
  maxEmployes    Int? // null = illimité
  maxSites       Int? // null = illimité
  essaiJours     Int      @default(0)
  // Modules activés, ex : ["QR","GPS","CONGES","HORAIRES_MULTIPLES","MULTI_SITES","RAPPORTS_AVANCES","ROLES_AVANCES","SURVEILLANT"]
  // Tout est modifiable depuis le backoffice (CRUD des packs), sans toucher au code.
  modules        Json
  ordre          Int      @default(0)
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entreprises Entreprise[]
}

model Entreprise {
  id             Int              @id @default(autoincrement())
  raisonSociale  String
  nomCommercial  String?
  secteur        String?
  pays           String           @default("CI")
  ville          String?
  adresse        String?
  identifiantLegal String?
  contactNom     String?
  contactFonction String?
  contactEmail   String?
  contactTel     String?
  fuseauHoraire  String           @default("Africa/Abidjan")
  statut         StatutEntreprise @default(ESSAI)
  packId         Int
  dateDemarrage  DateTime?
  dateEcheance   DateTime?
  profilComplete Boolean          @default(false)
  // Surcharges optionnelles (offre sur mesure) : si renseignées, elles priment sur le pack
  maxSitesOverride    Int?
  maxEmployesOverride Int?
  modulesOverride     Json?
  notesInternes  String?          @db.Text // invisibles du client
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  pack         Pack          @relation(fields: [packId], references: [id])
  utilisateurs Utilisateur[]
  sites        Site[]
  pointages    Pointage[]
  horaires     Horaire[]
  demandes     Demande[]
  factures     Facture[]
  invitations  Invitation[]
  audits       AuditLog[]

  @@index([statut])
  @@index([packId])
}

// ───────────── Utilisateurs ─────────────

model Utilisateur {
  id           Int          @id @default(autoincrement())
  entrepriseId Int? // null pour SUPER_ADMIN / SUPPORT
  siteId       Int? // site de rattachement (employé, surveillant)
  horaireId    Int?
  matricule    String?
  nom          String
  prenom       String
  email        String?      @unique
  telephone    String?      @unique // format international normalisé (+225...), connexion possible par numéro
  passwordHash String?
  role         Role
  statut       StatutCompte @default(INVITE)
  poste        String?
  // Salaire d'une journée travaillée (FCFA). Validé si arrivée + départ le même jour.
  salaireJournalier Int?
  dateEmbauche DateTime?
  photoUrl     String?
  mfaActif     Boolean      @default(false)
  derniereConnexion DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  entreprise Entreprise? @relation(fields: [entrepriseId], references: [id])
  site       Site?       @relation("SiteEmployes", fields: [siteId], references: [id])
  horaire    Horaire?    @relation(fields: [horaireId], references: [id])

  pointages         Pointage[]         @relation("PointageEmploye")
  pointagesEffectues Pointage[]        @relation("PointagePar")
  corrections       PointageCorrection[]
  demandes          Demande[]          @relation("DemandeEmploye")
  demandesTraitees  Demande[]          @relation("DemandeDecideur")
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  audits            AuditLog[]

  @@unique([entrepriseId, matricule])
  @@index([entrepriseId, role])
  @@index([siteId])
}

model Invitation {
  id           Int       @id @default(autoincrement())
  entrepriseId Int
  email        String
  role         Role
  tokenHash    String    @unique
  expireAt     DateTime
  utiliseeAt   DateTime?
  createdAt    DateTime  @default(now())

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])

  @@index([entrepriseId])
}

model RefreshToken {
  id            Int       @id @default(autoincrement())
  utilisateurId Int
  tokenHash     String    @unique
  appareil      String?
  expireAt      DateTime
  revoqueAt     DateTime?
  createdAt     DateTime  @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
}

// ───────────── Sites et horaires ─────────────

model Site {
  id           Int      @id @default(autoincrement())
  entrepriseId Int
  nom          String
  adresse      String?
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  rayonM       Int      @default(30) // paramétrable par site
  precisionMaxM Int     @default(50) // au-delà : le mobile demande de réessayer
  toleranceMin Int? // facultatif : minutes de retard acceptées ; null = aucune tolérance extra
  // Heures par jour ouvré, ex. [{"jour":1,"heureDebut":"08:00","heureFin":"17:00"}]
  // jour : 1 = lundi … 7 = dimanche.
  horairesJours Json
  qrToken      String   @unique // QR statique, jeton opaque, régénérable
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entreprise Entreprise    @relation(fields: [entrepriseId], references: [id])
  employes   Utilisateur[] @relation("SiteEmployes")
  pointages  Pointage[]

  @@index([entrepriseId])
}

model Horaire {
  id           Int      @id @default(autoincrement())
  entrepriseId Int
  nom          String
  heureDebut   String // "08:00"
  heureFin     String // "17:00"
  toleranceMin Int      @default(15)
  joursTravail Json // [1,2,3,4,5]
  createdAt    DateTime @default(now())

  entreprise   Entreprise    @relation(fields: [entrepriseId], references: [id])
  utilisateurs Utilisateur[]

  @@index([entrepriseId])
}

// ───────────── Pointages ─────────────

model Pointage {
  id            BigInt           @id @default(autoincrement())
  entrepriseId  Int
  employeId     Int
  siteId        Int
  pointeParId   Int? // surveillant si methode = SURVEILLANT
  type          TypePointage
  methode       MethodePointage
  latitude      Decimal?         @db.Decimal(10, 7)
  longitude     Decimal?         @db.Decimal(10, 7)
  precisionM    Float?
  distanceM     Float?
  statutValidation StatutValidation
  motifStatut   String? // ex : "distance 42 m, précision 18 m"
  mockDetecte   Boolean          @default(false)
  requestId     String           @unique // idempotence (double appui)
  heureServeur  DateTime         @default(now())
  createdAt     DateTime         @default(now())

  entreprise  Entreprise  @relation(fields: [entrepriseId], references: [id])
  employe     Utilisateur @relation("PointageEmploye", fields: [employeId], references: [id])
  pointePar   Utilisateur? @relation("PointagePar", fields: [pointeParId], references: [id])
  site        Site        @relation(fields: [siteId], references: [id])
  corrections PointageCorrection[]

  @@index([entrepriseId, heureServeur])
  @@index([employeId, heureServeur])
  @@index([siteId, heureServeur])
  @@index([statutValidation])
}

// La valeur d'origine du pointage n'est jamais écrasée : on trace avant/après.
model PointageCorrection {
  id          Int      @id @default(autoincrement())
  pointageId  BigInt
  auteurId    Int
  motif       String
  avant       Json
  apres       Json
  createdAt   DateTime @default(now())

  pointage Pointage    @relation(fields: [pointageId], references: [id])
  auteur   Utilisateur @relation(fields: [auteurId], references: [id])

  @@index([pointageId])
}

// ───────────── Absences et congés ─────────────

model Demande {
  id           Int           @id @default(autoincrement())
  entrepriseId Int
  employeId    Int
  type         TypeDemande
  dateDebut    DateTime      @db.Date
  dateFin      DateTime      @db.Date
  nbJours      Float?
  commentaire  String?       @db.Text
  justificatifUrl String?
  statut       StatutDemande @default(EN_ATTENTE)
  decideurId   Int?
  decisionMotif String?
  decideAt     DateTime?
  createdAt    DateTime      @default(now())

  entreprise Entreprise  @relation(fields: [entrepriseId], references: [id])
  employe    Utilisateur @relation("DemandeEmploye", fields: [employeId], references: [id])
  decideur   Utilisateur? @relation("DemandeDecideur", fields: [decideurId], references: [id])

  @@index([entrepriseId, statut])
  @@index([employeId])
}

// ───────────── Facturation ─────────────

model Facture {
  id           Int           @id @default(autoincrement())
  entrepriseId Int
  numero       String        @unique
  periodeDebut DateTime      @db.Date
  periodeFin   DateTime      @db.Date
  lignes       Json
  montantHT    Int
  taxes        Int           @default(0)
  montantTTC   Int
  echeance     DateTime      @db.Date
  statut       StatutFacture @default(EMISE)
  createdAt    DateTime      @default(now())

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id])
  paiements  Paiement[]

  @@index([entrepriseId, statut])
}

model Paiement {
  id         Int      @id @default(autoincrement())
  factureId  Int
  montant    Int
  moyen      String // WAVE, ORANGE_MONEY, VIREMENT, ESPECES...
  reference  String?
  recuUrl    String?
  payeAt     DateTime
  createdAt  DateTime @default(now())

  facture Facture @relation(fields: [factureId], references: [id])

  @@index([factureId])
}

// ───────────── Notifications et audit ─────────────

model Notification {
  id            Int       @id @default(autoincrement())
  utilisateurId Int
  titre         String
  message       String    @db.Text
  type          String
  luAt          DateTime?
  createdAt     DateTime  @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, luAt])
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  entrepriseId Int?
  acteurId     Int?
  action       String // ex : POINTAGE_CORRIGE, ROLE_MODIFIE, EXPORT, SUSPENSION
  objet        String?
  objetId      String?
  details      Json?
  ip           String?
  resultat     String   @default("OK")
  createdAt    DateTime @default(now())

  entreprise Entreprise? @relation(fields: [entrepriseId], references: [id])
  acteur     Utilisateur? @relation(fields: [acteurId], references: [id])

  @@index([entrepriseId, createdAt])
  @@index([acteurId])
}
